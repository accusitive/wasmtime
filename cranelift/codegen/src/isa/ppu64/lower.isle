;; Lowering rules for ppu64 (Cell BE PPU, PowerPC64).

;; The main lowering constructor term: takes a clif `Inst` and returns the
;; register(s) within which the lowered instruction's result values live.
(decl partial lower (Inst) InstOutput)

;;;; Rules for `iconst` ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (iconst ty (u64_from_imm64 n)))
  (imm ty n))

;; Load an integer constant into a register. Implemented as an extern
;; constructor so the choice between `li`, `ori`, `lis`+`ori`, and the full
;; 64-bit sequence can be made in Rust.
(decl gen_li (Type u64) Reg)
(extern constructor gen_li gen_li)

(decl imm (Type u64) InstOutput)
(rule (imm ty n) (output_xreg (gen_li ty n)))

;;;; Extern constructors ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl memflags_trusted () MemFlagsData)
(extern constructor memflags_trusted memflags_trusted)

(decl label_to_br_target (MachLabel) CondBrTarget)
(extern constructor label_to_br_target label_to_br_target)

(decl amode_from_ptr (Value Offset32) AMode)
(extern constructor amode_from_ptr amode_from_ptr)

(decl int_compare_from_values (IntCC Value Value) IntegerCompare)
(extern constructor int_compare_from_values int_compare_from_values)

(decl int_compare_nonzero (Value) IntegerCompare)
(extern constructor int_compare_nonzero int_compare_nonzero)

(decl pure int_compare_inverse (IntegerCompare) IntegerCompare)
(extern constructor int_compare_inverse int_compare_inverse)

(decl gen_icmp (IntCC Value Value) Reg)
(extern constructor gen_icmp gen_icmp)

(decl gen_store_default (Value Value Offset32) InstOutput)
(extern constructor gen_store_default gen_store_default)

;;;; Helpers for emitting machine instructions ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Emit a two-source ALU op; returns the destination register.
(decl alu_rrr (AluOPRRR Reg Reg) XReg)
(rule (alu_rrr op src1 src2)
  (let ((dst WritableXReg (temp_writable_xreg))
        (_ Unit (emit (MInst.AluRRR op dst src1 src2))))
    dst))

;;;; Rules for integer arithmetic ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule -1 (lower (iadd _ x y)) (alu_rrr (AluOPRRR.Add) x y))
(rule -1 (lower (imul _ x y)) (alu_rrr (AluOPRRR.Mulld) x y))
(rule -1 (lower (band _ x y)) (alu_rrr (AluOPRRR.And) x y))
(rule -1 (lower (bor _ x y)) (alu_rrr (AluOPRRR.Or) x y))
(rule -1 (lower (bxor _ x y)) (alu_rrr (AluOPRRR.Xor) x y))

;; `subf rd, ra, rb` computes rb - ra, so operands are swapped relative to
;; CLIF's `isub`.
(rule -1 (lower (isub _ x y)) (alu_rrr (AluOPRRR.Subf) y x))

;; Bitwise not is a NOR with both operands tied together.
(rule -1 (lower (bnot _ x)) (alu_rrr (AluOPRRR.Nor) x x))

;; Negate
(rule -1 (lower (has_type $I64 (ineg _ x))) (let ((dst WritableXReg (temp_writable_xreg)) (_ Unit (emit (MInst.AluRR (AluOPRR.Neg) dst x)))) (output_xreg dst)))
(rule -1 (lower (has_type $I32 (ineg _ x))) (let ((dst WritableXReg (temp_writable_xreg)) (_ Unit (emit (MInst.AluRR (AluOPRR.Neg) dst x)))) (output_xreg dst)))
(decl gen_iabs (Type Value) InstOutput)
(extern constructor gen_iabs gen_iabs)
(rule -1 (lower (has_type ty (iabs _ x))) (gen_iabs ty x))

;; iconcat/isplit
(decl gen_iconcat (Value Value) InstOutput)
(extern constructor gen_iconcat gen_iconcat)
(rule -1 (lower (has_type $I64 (iconcat _ lo hi))) (gen_iconcat lo hi))
(decl gen_isplit (Value) InstOutput)
(extern constructor gen_isplit gen_isplit)
(rule -1 (lower (isplit _ x @ (value_type $I64))) (gen_isplit x))

;; Division, trapping on a zero divisor.
(decl div_checked (AluOPRRR Value Value) InstOutput)
(rule (div_checked op x y)
  (let ((_ Unit (div_zero_check y)))
    (output_xreg (alu_rrr op x y))))

(decl div_zero_check (Value) Unit)
(rule (div_zero_check divisor)
  (emit_side_effect (SideEffectNoResult.Inst
                      (MInst.TrapIf
                        (int_compare_inverse (int_compare_nonzero divisor))
                        (TrapCode.INTEGER_DIVISION_BY_ZERO)))))

(rule -1 (lower (sdiv _ x y)) (div_checked (AluOPRRR.Divd) x y))
(rule -1 (lower (udiv _ x y)) (div_checked (AluOPRRR.Divdu) x y))

;; Remainders are synthesized as div + mul + sub.
(rule -1 (lower (srem _ x y)) (rem_impl (AluOPRRR.Divd) x y))
(rule -1 (lower (urem _ x y)) (rem_impl (AluOPRRR.Divdu) x y))

(decl rem_impl (AluOPRRR Value Value) InstOutput)
(rule (rem_impl div_op a b)
  (let ((_ Unit (div_zero_check b)))
    (let ((q WritableXReg (temp_writable_xreg)))
      (let ((prod WritableXReg (temp_writable_xreg)))
        (let ((result WritableXReg (temp_writable_xreg)))
          (let ((_ Unit (emit (MInst.AluRRR div_op q a b))))
            (let ((_ Unit (emit (MInst.AluRRR (AluOPRRR.Mulld) prod q b))))
              ;; subf computes rb - ra, i.e. a - q*b here.
              (let ((_ Unit (emit (MInst.AluRRR (AluOPRRR.Subf) result prod a))))
                (output_reg result)))))))))

;;;; Shifts ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (has_type $I64 (ishl _ x y))) (alu_rrr (AluOPRRR.Sld) x y))
(rule (lower (has_type $I64 (ushr _ x y))) (alu_rrr (AluOPRRR.Srd) x y))
(rule (lower (has_type $I64 (sshr _ x y))) (alu_rrr (AluOPRRR.Srad) x y))
(rule -1 (lower (has_type (fits_in_32 (ty_int _)) (ishl _ x y))) (alu_rrr (AluOPRRR.Slw) x y))
(rule -1 (lower (has_type (fits_in_32 (ty_int _)) (ushr _ x y))) (alu_rrr (AluOPRRR.Srw) x y))
(rule -1 (lower (has_type (fits_in_32 (ty_int _)) (sshr _ x y))) (alu_rrr (AluOPRRR.Sraw) x y))

;;;; Loads and stores ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl pure load_op_for (Type) LoadOP)
(rule (load_op_for $I8) (LoadOP.Lbz))
(rule (load_op_for $I16) (LoadOP.Lhz))
(rule (load_op_for $I32) (LoadOP.Lwz))
(rule (load_op_for $I64) (LoadOP.Ld))
(rule (load_op_for $F32) (LoadOP.Lfs))
(rule (load_op_for $F64) (LoadOP.Lfd))

(decl store_op (StoreOP Value Value Offset32) InstOutput)
(rule (store_op op val p offset)
  (let ((src Reg (put_in_reg val)))
    (let ((mem AMode (amode_from_ptr p offset)))
      (let ((_ Unit (emit (MInst.Store op src (memflags_trusted) mem))))
        (output_none)))))

(rule (lower (store _ val p offset))
  (gen_store_default val p offset))

;; Sign/zero-extending small loads: load the zero-extending form, then
;; apply an explicit extend.
(rule (lower (has_type _ (sload8 _ _ p offset)))  (extend_after_load true 8 p offset))
(rule (lower (has_type _ (uload8 _ _ p offset)))  (extend_after_load false 8 p offset))
(rule (lower (has_type _ (sload16 _ _ p offset))) (extend_after_load true 16 p offset))
(rule (lower (has_type _ (uload16 _ _ p offset))) (extend_after_load false 16 p offset))
(rule (lower (has_type _ (sload32 _ _ p offset))) (extend_after_load true 32 p offset))
(rule (lower (has_type _ (uload32 _ _ p offset))) (extend_after_load false 32 p offset))
(rule (lower (has_type _ (uload8x8 _ _ p offset)))  (vector_extend_load $I8X16 8 p offset))
(rule (lower (has_type _ (sload8x8 _ _ p offset)))  (vector_extend_load $I8X16 8 p offset))
(rule (lower (has_type _ (uload16x4 _ _ p offset))) (vector_extend_load $I16X8 16 p offset))
(rule (lower (has_type _ (sload16x4 _ _ p offset))) (vector_extend_load $I16X8 16 p offset))
(rule (lower (has_type _ (uload32x2 _ _ p offset))) (vector_extend_load $I32X4 32 p offset))
(rule (lower (has_type _ (sload32x2 _ _ p offset))) (vector_extend_load $I32X4 32 p offset))

(decl extend_after_load (bool u8 Value Offset32) InstOutput)
(rule (extend_after_load signed bits p offset)
  (let ((src WritableReg (temp_writable_reg $I64)))
    (let ((dst WritableReg (temp_writable_reg $I64)))
      (let ((mem AMode (amode_from_ptr p offset)))
        (let ((_ Unit (emit (MInst.Load (small_load_op bits) src (memflags_trusted) mem))))
          (let ((_ Unit (emit (MInst.Extend dst src signed bits))))
            (output_reg dst)))))))
(decl vector_extend_load (Type u8 Value Offset32) InstOutput)
(rule (vector_extend_load ty bits p offset)
  (let ((dst WritableReg (temp_writable_reg ty))
        (mem AMode (amode_from_ptr p offset))
        (_ Unit (emit (MInst.VecLoad dst mem))))
    (output_reg dst)))

(decl pure small_load_op (u8) LoadOP)
(rule (small_load_op 8) (LoadOP.Lbz))
(rule (small_load_op 16) (LoadOP.Lhz))
(rule (small_load_op 32) (LoadOP.Lwz))

;; Truncating stores.
(rule (lower (istore8 _ val p offset))  (store_op (StoreOP.Stb) val p offset))
(rule (lower (istore16 _ val p offset)) (store_op (StoreOP.Sth) val p offset))
(rule (lower (istore32 _ val p offset)) (store_op (StoreOP.Stw) val p offset))

;; Plain load of any scalar type.
(rule (lower (load ty _ p offset))
  (let ((dst WritableReg (temp_writable_reg ty)))
    (let ((mem AMode (amode_from_ptr p offset)))
      (let ((_ Unit (emit (MInst.Load (load_op_for ty) dst (memflags_trusted) mem))))
        (output_reg dst)))))

;;;; Extends and reduces ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (has_type _ (sextend _ y @ (value_type ity))))
  (extend_helper true (ty_bits ity) y))

(rule (lower (has_type _ (uextend _ y @ (value_type ity))))
  (extend_helper false (ty_bits ity) y))

(decl extend_helper (bool u8 Value) InstOutput)
(rule (extend_helper signed bits y)
  (let ((dst WritableReg (temp_writable_reg $I64)))
    (let ((src Reg (put_in_reg y)))
      (let ((_ Unit (emit (MInst.Extend dst src signed bits))))
        (output_reg dst)))))

(rule (lower (ireduce _ y)) (output_reg (put_in_reg y)))

;;;; Integer comparison ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (has_type _ (icmp _ cc x y)))
  (output_reg (gen_icmp cc x y)))

;;;; Control flow ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(rule (lower (return args)) (lower_return args))

;; Traps.
(rule (lower (trap code)) (side_effect (SideEffectNoResult.Inst (MInst.Udf code))))

;; Calls. Only the non-patchable forms for now; patchable calls come later.
(rule (lower (call (func_ref_data sig_ref name dist false) args))
  (let ((output ValueRegsVec (gen_call_output sig_ref))
        (abi Sig (abi_sig sig_ref))
        (uses CallArgList (gen_call_args abi args))
        (defs CallRetList (gen_call_rets abi output))
        (info BoxCallInfo (gen_call_info abi name uses defs (try_call_none) false))
        (_ Unit (emit_side_effect (SideEffectNoResult.Inst (MInst.Call info)))))
    output))

(rule (lower (call_indirect sig_ref ptr args))
  (let ((output ValueRegsVec (gen_call_output sig_ref))
        (abi Sig (abi_sig sig_ref))
        (target Reg (put_in_reg ptr))
        (uses CallArgList (gen_call_args abi args))
        (defs CallRetList (gen_call_rets abi output))
        (info BoxCallIndInfo (gen_call_ind_info abi target uses defs (try_call_none)))
        (_ Unit (emit_side_effect (SideEffectNoResult.Inst (MInst.CallInd info)))))
    output))

;;;; Branch lowering ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl partial lower_branch (Inst MachLabelSlice) Unit)

(rule (lower_branch (jump _) (single_target label))
  (emit_side_effect (SideEffectNoResult.Inst (MInst.Jmp label))))

;; Conditional branch on an icmp: fuse compare and branch into one pseudo.
(rule 0 (lower_branch (brif (icmp _ cc x y) _ _) (two_targets then else))
  (emit_side_effect (SideEffectNoResult.Inst
                      (MInst.CondBr
                        (label_to_br_target then)
                        (label_to_br_target else)
                        (int_compare_from_values cc x y)))))

;; Generic conditional branch on any value: compare against zero.
(rule -1 (lower_branch (brif c _ _) (two_targets then else))
  (emit_side_effect (SideEffectNoResult.Inst
                      (MInst.CondBr
                        (label_to_br_target then)
                        (label_to_br_target else)
                        (int_compare_nonzero c)))))

(rule (lower_branch (trapnz cond code) (single_target _))
  (emit_side_effect (SideEffectNoResult.Inst (MInst.TrapIf (int_compare_nonzero cond) code))))

(rule (lower_branch (trapz cond code) (single_target _))
  (emit_side_effect (SideEffectNoResult.Inst (MInst.TrapIf (int_compare_inverse (int_compare_nonzero cond)) code))))

(rule (lower_branch (br_table index _) (jump_table_targets default targets))
  (let ((tmp1 WritableReg (temp_writable_reg $I64))
        (tmp2 WritableReg (temp_writable_reg $I64))
        (idx Reg (put_in_reg index)))
    (emit_side_effect (SideEffectNoResult.Inst (MInst.BrTable idx tmp1 tmp2 default targets)))))

;;;; Floating point ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl gen_f64const (u64) InstOutput)
(extern constructor gen_f64const gen_f64const)

(decl gen_f32const (u32) InstOutput)
(extern constructor gen_f32const gen_f32const)

(rule -1 (lower (has_type $F64 (f64const _ (u64_from_ieee64 n)))) (gen_f64const n))
(rule -1 (lower (has_type $F32 (f32const _ (u32_from_ieee32 n)))) (gen_f32const n))

(decl gen_fbinop (FpuOPRRR Type Value Value) InstOutput)
(extern constructor gen_fbinop gen_fbinop)

(decl gen_funop (FpuOPRR Value) InstOutput)
(extern constructor gen_funop gen_funop)

(decl gen_fcvt_from_sint (Type Type Value) InstOutput)
(extern constructor gen_fcvt_from_sint gen_fcvt_from_sint)

(decl gen_fcvt_from_uint (Type Type Value) InstOutput)
(extern constructor gen_fcvt_from_uint gen_fcvt_from_uint)

(decl gen_promote (Value) InstOutput)
(extern constructor gen_promote gen_promote)

(decl gen_bitcast_i64_f64 (Value) InstOutput)
(extern constructor gen_bitcast_i64_f64 gen_bitcast_i64_f64)

(decl gen_bitcast_f64_i64 (Value) InstOutput)
(extern constructor gen_bitcast_f64_i64 gen_bitcast_f64_i64)

(decl gen_fcmp (FloatCC Value Value) Reg)
(extern constructor gen_fcmp gen_fcmp)

(rule -1 (lower (has_type $F64 (fadd _ x y))) (gen_fbinop (FpuOPRRR.Fadd) $F64 x y))
(rule -1 (lower (has_type $F32 (fadd _ x y))) (gen_fbinop (FpuOPRRR.Fadd) $F32 x y))
(rule -1 (lower (has_type $F64 (fsub _ x y))) (gen_fbinop (FpuOPRRR.Fsub) $F64 x y))
(rule -1 (lower (has_type $F32 (fsub _ x y))) (gen_fbinop (FpuOPRRR.Fsub) $F32 x y))
(rule -1 (lower (has_type $F64 (fmul _ x y))) (gen_fbinop (FpuOPRRR.Fmul) $F64 x y))
(rule -1 (lower (has_type $F32 (fmul _ x y))) (gen_fbinop (FpuOPRRR.Fmul) $F32 x y))
(rule -1 (lower (has_type $F64 (fdiv _ x y))) (gen_fbinop (FpuOPRRR.Fdiv) $F64 x y))
(rule -1 (lower (has_type $F32 (fdiv _ x y))) (gen_fbinop (FpuOPRRR.Fdiv) $F32 x y))

(rule -1 (lower (fneg _ x)) (gen_funop (FpuOPRR.Fneg) x))
(rule -1 (lower (fabs _ x)) (gen_funop (FpuOPRR.Fabs) x))

;; Integer -> float conversions.
(rule (lower (has_type res_ty (fcvt_from_sint _ y @ (value_type src_ty))))
  (gen_fcvt_from_sint res_ty src_ty y))

(rule (lower (has_type res_ty (fcvt_from_uint _ y @ (value_type src_ty))))
  (gen_fcvt_from_uint res_ty src_ty y))

;; f32 <-> f64.
(rule (lower (has_type $F64 (fpromote _ x))) (gen_promote x))
(rule (lower (has_type $F32 (fdemote _ x))) (gen_funop (FpuOPRR.Frsp) x))

;; Raw bit moves between 64-bit ints and doubles.
(rule (lower (has_type $F64 (bitcast _ _ x @ (value_type $I64)))) (gen_bitcast_i64_f64 x))
(rule (lower (has_type $I64 (bitcast _ _ x @ (value_type $F64)))) (gen_bitcast_f64_i64 x))

;; Float comparisons materialize as 0/1 like integer compares.
(rule (lower (has_type _ (fcmp _ cc x y)))
  (output_reg (gen_fcmp cc x y)))

;;;; Rotates, counts, byte swaps, selects ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; rotl(x, y) = (x <<a y) | (x >>a (64 - y)).
(rule -1 (lower (has_type $I64 (rotl _ x y))) (rotl_impl x y))
(rule -1 (lower (has_type $I64 (rotr _ x y))) (rotr_impl x y))
(decl rotl_impl (Value Value) InstOutput)
(rule (rotl_impl x y)
  (let ((xr Reg (put_in_reg x))
        (yr Reg (put_in_reg y))
        (left WritableXReg (temp_writable_xreg)))
    (let ((_ Unit (emit (MInst.AluRRR (AluOPRRR.Sld) left xr yr))))
      (let ((k64 WritableXReg (temp_writable_xreg)))
        (let ((_ Unit (emit (MInst.Li32 k64 64))))
          (let ((ry WritableXReg (temp_writable_xreg)))
            (let ((_ Unit (emit (MInst.AluRRR (AluOPRRR.Subf) ry yr (writable_xreg_to_xreg k64)))))
              (let ((right WritableXReg (temp_writable_xreg)))
                (let ((_ Unit (emit (MInst.AluRRR (AluOPRRR.Srd) right xr (writable_xreg_to_xreg ry)))))
                  (output_xreg (alu_rrr (AluOPRRR.Or) (writable_xreg_to_xreg left) (writable_xreg_to_xreg right))))))))))))

;; rotr(x, y) = (x >>a y) | (x <<a (64 - y)).
(decl rotr_impl (Value Value) InstOutput)
(rule (rotr_impl x y)
  (let ((xr Reg (put_in_reg x))
        (yr Reg (put_in_reg y))
        (right WritableXReg (temp_writable_xreg)))
    (let ((_ Unit (emit (MInst.AluRRR (AluOPRRR.Srd) right xr yr))))
      (let ((k64 WritableXReg (temp_writable_xreg)))
        (let ((_ Unit (emit (MInst.Li32 k64 64))))
          (let ((ly WritableXReg (temp_writable_xreg)))
            (let ((_ Unit (emit (MInst.AluRRR (AluOPRRR.Subf) ly yr (writable_xreg_to_xreg k64)))))
              (let ((left WritableXReg (temp_writable_xreg)))
                (let ((_ Unit (emit (MInst.AluRRR (AluOPRRR.Sld) left xr (writable_xreg_to_xreg ly)))))
                  (output_xreg (alu_rrr (AluOPRRR.Or) (writable_xreg_to_xreg left) (writable_xreg_to_xreg right))))))))))))

;; Leading/trailing zeros.
(rule -1 (lower (has_type $I64 (clz _ x))) (clz_impl true x))
(rule -1 (lower (has_type $I32 (clz _ x))) (clz_impl false x))
(decl clz_impl (bool Value) InstOutput)
(rule (clz_impl is64 x)
  (let ((src Reg (zext_or_sext is64 x)))
    (let ((rd WritableReg (temp_writable_reg $I64)))
      (let ((_ Unit (emit (MInst.Clz rd src is64))))
        (output_reg rd)))))

;; Extract the operand as a zero-extended 64-bit value for 32-bit
;; operations; pass 64-bit operands through.
(decl zext_or_sext (bool Value) Reg)
(extern constructor zext_or_sext zext_or_sext)

;; ctz(x) = 63 - clz(x & -x) on a 64-bit lane.
(rule -1 (lower (has_type $I64 (ctz _ x))) (ctz_impl true x))
(rule -1 (lower (has_type $I32 (ctz _ x))) (ctz_impl false x))
(decl ctz_impl (bool Value) InstOutput)
(rule (ctz_impl is64 x)
  (let ((src Reg (zext_or_sext is64 x)))
    (let ((neg WritableXReg (temp_writable_xreg)))
      (let ((_ Unit (emit (MInst.AluRR (AluOPRR.Neg) neg src))))
        (let ((t WritableXReg (temp_writable_xreg)))
          (let ((_ Unit (emit (MInst.AluRRR (AluOPRRR.And) t src (writable_xreg_to_xreg neg)))))
            (let ((rd WritableReg (temp_writable_reg $I64)))
              (let ((_ Unit (emit (MInst.Clz rd (writable_reg_to_reg t) is64))))
                ;; subtract from 63: subf computes rb - ra, i.e. 63 - clz
                (let ((k63 WritableXReg (temp_writable_xreg)))
                  (let ((_ Unit (emit (MInst.Li32 k63 63))))
                    (output_xreg (alu_rrr (AluOPRRR.Subf)
                                          (writable_reg_to_reg rd)
                                          (writable_xreg_to_xreg k63)))))))))))))

;; Population count via SWAR; implemented in Rust for clarity.
(decl gen_popcnt (Type Value) InstOutput)
(extern constructor gen_popcnt gen_popcnt)
(rule -1 (lower (has_type $I64 (popcnt _ x))) (gen_popcnt $I64 x))
(rule -1 (lower (has_type $I32 (popcnt _ x))) (gen_popcnt $I32 x))

;; Byte swaps built from rlwinm field extractions (32-bit) composed for
;; the 64-bit form.
(decl gen_bswap (Type Value) InstOutput)
(extern constructor gen_bswap gen_bswap)
(rule -1 (lower (has_type $I32 (bswap _ x))) (gen_bswap $I32 x))
(rule -1 (lower (has_type $I16 (bswap _ x))) (gen_bswap $I16 x))
(rule -1 (lower (has_type $I64 (bswap _ x))) (gen_bswap $I64 x))

;; Integer select via a bit mask: cond!=0 -> mask=-1.
(decl gen_select_int (Value Value Value) InstOutput)
(extern constructor gen_select_int gen_select_int)
(rule -1 (lower (select $I64 c x y)) (gen_select_int c x y))
(rule -1 (lower (select $I32 c x y)) (gen_select_int c x y))

;; bmask
(decl gen_bmask (Type Value) InstOutput)
(extern constructor gen_bmask gen_bmask)
(rule -1 (lower (has_type ty (bmask _ x))) (gen_bmask ty x))

;; bitrev
(decl gen_bitrev (Type Value) InstOutput)
(extern constructor gen_bitrev gen_bitrev)
(rule -1 (lower (has_type ty (bitrev _ x))) (gen_bitrev ty x))

;; smin/smax/umin/umax via icmp+select
(decl gen_sminmax (Type Value Value bool bool) InstOutput)
(extern constructor gen_sminmax gen_sminmax)
(rule -1 (lower (has_type ty (smin _ x y))) (gen_sminmax ty x y true false))
(rule -1 (lower (has_type ty (smax _ x y))) (gen_sminmax ty x y true true))
(rule -1 (lower (has_type ty (umin _ x y))) (gen_sminmax ty x y false false))
(rule -1 (lower (has_type ty (umax _ x y))) (gen_sminmax ty x y false true))

(decl gen_stack_addr (StackSlot Offset32) Reg)
(extern constructor gen_stack_addr gen_stack_addr)

(rule -1 (lower (has_type $I64 (stack_addr _ ss offset)))
  (output_reg (gen_stack_addr ss offset)))
(rule -1 (lower (has_type $I32 (stack_addr _ ss offset)))
  (let ((addr64 Reg (gen_stack_addr ss offset))
        (addr32 WritableReg (temp_writable_reg $I32)))
    (let ((_ Unit (emit (MInst.Rlwinm addr32 addr64 0 0 31))))
      (output_reg (writable_reg_to_reg addr32)))))

;;;; Saturating float->int conversions ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl gen_fcvt_to_sint_sat (Value) InstOutput)
(extern constructor gen_fcvt_to_sint_sat gen_fcvt_to_sint_sat)

(decl gen_fcvt_to_uint_sat (Value) InstOutput)
(extern constructor gen_fcvt_to_uint_sat gen_fcvt_to_uint_sat)

(decl gen_fcvt_to_sint_sat_i32 (Value) InstOutput)
(extern constructor gen_fcvt_to_sint_sat_i32 gen_fcvt_to_sint_sat_i32)

(decl gen_fcvt_to_uint_sat_i32 (Value) InstOutput)
(extern constructor gen_fcvt_to_uint_sat_i32 gen_fcvt_to_uint_sat_i32)

(rule -1 (lower (has_type $I64 (fcvt_to_sint_sat _ x))) (gen_fcvt_to_sint_sat x))
(rule -1 (lower (has_type $I64 (fcvt_to_uint_sat _ x))) (gen_fcvt_to_uint_sat x))
(rule -1 (lower (has_type $I32 (fcvt_to_sint_sat _ x))) (gen_fcvt_to_sint_sat_i32 x))
(rule -1 (lower (has_type $I32 (fcvt_to_uint_sat _ x))) (gen_fcvt_to_uint_sat_i32 x))

;;;; Integral rounding ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl gen_fround (u8 Value) InstOutput)
(extern constructor gen_fround gen_fround)

(rule -1 (lower (has_type $F64 (trunc _ x))) (gen_fround 0 x))
(rule -1 (lower (has_type $F64 (floor _ x))) (gen_fround 1 x))
(rule -1 (lower (has_type $F64 (ceil _ x))) (gen_fround 2 x))

;;;; fmin/fmax ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl gen_fminmax (bool Value Value) InstOutput)
(extern constructor gen_fminmax gen_fminmax)

(rule -1 (lower (has_type $F64 (fmin _ x y))) (gen_fminmax false x y))
(rule -1 (lower (has_type $F64 (fmax _ x y))) (gen_fminmax true x y))
(rule -1 (lower (has_type $F32 (fmin _ x y))) (gen_fminmax false x y))
(rule -1 (lower (has_type $F32 (fmax _ x y))) (gen_fminmax true x y))

;;;; Vectors (AltiVec, 128-bit) ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl vec_alu (VecALUOp Value Value) InstOutput)
(rule (vec_alu op x y)
  (let ((dst WritableReg (temp_writable_reg $I8X16))
        (src1 Reg (put_in_reg x))
        (src2 Reg (put_in_reg y))
        (_ Unit (emit (MInst.VecALU op dst src1 src2))))
    (output_reg dst)))

(rule 1 (lower (has_type $I8X16 (iadd _ x y))) (vec_alu (VecALUOp.Vaddubm) x y))
(rule 1 (lower (has_type $I16X8 (iadd _ x y))) (vec_alu (VecALUOp.Vadduhm) x y))
(rule 1 (lower (has_type $I32X4 (iadd _ x y))) (vec_alu (VecALUOp.Vadduwm) x y))
(rule 1 (lower (has_type $F32X4 (fadd _ x y))) (vec_alu (VecALUOp.Vaddfp) x y))
(rule 1 (lower (has_type $I8X16 (isub _ x y))) (vec_alu (VecALUOp.Vsububm) x y))
(rule 1 (lower (has_type $I8X16 (band _ x y))) (vec_alu (VecALUOp.Vand) x y))
(rule 1 (lower (has_type $I8X16 (bor _ x y))) (vec_alu (VecALUOp.Vor) x y))
(rule 1 (lower (has_type $I8X16 (bxor _ x y))) (vec_alu (VecALUOp.Vxor) x y))

;; Vector loads/stores
(decl vec_load (Type Value Offset32) InstOutput)
(rule (vec_load ty p off)
  (let ((dst WritableReg (temp_writable_reg ty))
        (mem AMode (amode_from_ptr p off))
        (_ Unit (emit (MInst.VecLoad dst mem))))
    (output_reg dst)))
(decl vec_store (Value Value Offset32) InstOutput)
(rule (vec_store val p off)
  (let ((src Reg (put_in_reg val))
        (mem AMode (amode_from_ptr p off))
        (_ Unit (emit (MInst.VecStore src mem))))
    (output_none)))
(rule 1 (lower (has_type $I8X16 (load _ _ p off))) (vec_load $I8X16 p off))
(rule 1 (lower (has_type $I32X4 (load _ _ p off))) (vec_load $I32X4 p off))
(rule 1 (lower (has_type $F32X4 (load _ _ p off))) (vec_load $F32X4 p off))
(rule 1 (lower (has_type $I8X16 (store _ val p off))) (vec_store val p off))
(rule 1 (lower (has_type $I32X4 (store _ val p off))) (vec_store val p off))
(rule 1 (lower (has_type $F32X4 (store _ val p off))) (vec_store val p off))

;;;; Atomics ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl gen_atomic_load (Type MemFlags Value) InstOutput)
(extern constructor gen_atomic_load gen_atomic_load)
(rule -1 (lower (atomic_load ty flags p)) (gen_atomic_load ty flags p))

(decl gen_atomic_store (MemFlags Value Value) InstOutput)
(extern constructor gen_atomic_store gen_atomic_store)
(rule -1 (lower (atomic_store flags val p)) (gen_atomic_store flags val p))

(decl gen_atomic_rmw (Type MemFlags Value Value AtomicRmwOp) InstOutput)
(extern constructor gen_atomic_rmw gen_atomic_rmw)
(rule -1 (lower (atomic_rmw ty flags op p x)) (gen_atomic_rmw ty flags p x op))

(decl gen_atomic_cas (Type MemFlags Value Value Value) InstOutput)
(extern constructor gen_atomic_cas gen_atomic_cas)
(rule -1 (lower (atomic_cas ty flags p e x)) (gen_atomic_cas ty flags p e x))

(rule -1 (lower (fence)) (side_effect (SideEffectNoResult.Inst (MInst.Fence))))

;;;; 32-bit bitcasts ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(decl gen_bitcast_f32_i32 (Value) InstOutput)
(extern constructor gen_bitcast_f32_i32 gen_bitcast_f32_i32)

(decl gen_bitcast_i32_f32 (Value) InstOutput)
(extern constructor gen_bitcast_i32_f32 gen_bitcast_i32_f32)

(rule -1 (lower (has_type $F32 (bitcast _ _ x @ (value_type $I32)))) (gen_bitcast_f32_i32 x))
(rule -1 (lower (has_type $I32 (bitcast _ _ x @ (value_type $F32)))) (gen_bitcast_i32_f32 x))

;;;; fnearest ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(decl gen_fnearest (Value) InstOutput)
(extern constructor gen_fnearest gen_fnearest)
(rule -1 (lower (has_type $F64 (nearest _ x))) (gen_fnearest x))
(rule -1 (lower (has_type $F32 (nearest _ x))) (gen_fnearest x))

;;;; sqrt ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(rule -1 (lower (has_type $F64 (sqrt _ x))) (gen_funop (FpuOPRR.Fsqrt) x))
(rule -1 (lower (has_type $F32 (sqrt _ x))) (gen_funop (FpuOPRR.Fsqrt) x))

;;;; fma ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(decl gen_fma (Value Value Value) InstOutput)
(extern constructor gen_fma gen_fma)
(rule -1 (lower (has_type $F64 (fma _ x y z))) (gen_fma x y z))
(rule -1 (lower (has_type $F32 (fma _ x y z))) (gen_fma x y z))
