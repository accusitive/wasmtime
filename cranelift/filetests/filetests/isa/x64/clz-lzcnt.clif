test compile precise-output
set enable_llvm_abi_extensions=true
target x86_64 has_lzcnt


function %clz(i128) -> i128 {
block0(v0: i128):
    v1 = clz v0
    return v1
}

; VCode:
; block0:
;   lzcntq %rsi, %rsi
;   lzcntq %rdi, %rax
;   addq $0x40, %rax
;   cmpq $0x40, %rsi
;   cmovneq %rsi, %rax
;   uninit  %rdx
;   xorq %rdx, %rdx
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   lzcntq %rsi, %rsi
;   lzcntq %rdi, %rax
;   addq $0x40, %rax
;   cmpq $0x40, %rsi
;   cmovneq %rsi, %rax
;   xorq %rdx, %rdx
;   retq

