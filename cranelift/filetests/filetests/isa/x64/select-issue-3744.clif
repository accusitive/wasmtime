test compile precise-output
target x86_64

; Check that no intervening moves are inserted when lowering `select` (see
; https://github.com/bytecodealliance/wasmtime/issues/3744).
function %select_eq_f32(f32, f32) -> i32 {
block0(v0: f32, v1: f32):
    v2 = fcmp eq v0, v1
    v3 = iconst.i32 1
    v4 = iconst.i32 0
    v5 = select v2, v3, v4
    return v5
}

; VCode:
; block0:
;   movl $0x1, %eax
;   ucomiss %xmm1, %xmm0
;   cmovpl (%rip), %eax
;   cmovnel (%rip), %eax
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   movl $1, %eax
;   ucomiss %xmm1, %xmm0
;   cmovpl 9(%rip), %eax
;   cmovnel 2(%rip), %eax
;   retq
;   addb %al, (%rax)
;   addb %al, (%rax)
;   addb %al, (%rax)
;   addb %al, (%rax)
;   .byte 0x00

