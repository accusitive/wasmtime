test compile precise-output
target x86_64

;; One output, one input: copy the input into the output register and
;; increment it. Placeholders number outputs first, then inputs.
function %inc(i64) -> i64 {
block0(v0: i64):
    v1 = inline_asm "movq %1, %0 ; addq $1, %0" : "=r" : "r"(v0)
    return v1
}

; VCode:
; block0:
;   inline_asm "movq %1, %0 ; addq $1, %0", uses=[%rdi], defs=[%rax]
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   movq %rdi, %rax
;   addq $1, %rax
;   retq

;; A bare asm statement with a clobber: no operands, destroys %r10.
function %clobber() {
block0:
    inline_asm "movq $1, %r10" : : : "r10"
    return
}

; VCode:
; block0:
;   inline_asm "movq $1, %r10", uses=[], defs=[]
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   movl $1, %r10d
;   retq

