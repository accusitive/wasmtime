function %mix_select_and_brif_rhs(f32, i64, i32, i32) -> i32, i32 {
block0(v0: f32, v1: i64, v2: i32, v3: i32):
  v4 = load.f32 notrap aligned v1
  v5 = fcmp eq v0, v4
  v6 = select v5, v2, v3
  brif v5, block1(v3), block1(v2)
block1(v7: i32):
  return v6, v7
}

