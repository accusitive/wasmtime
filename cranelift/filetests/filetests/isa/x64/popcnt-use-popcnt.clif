test compile precise-output
target x86_64 has_popcnt has_sse42

function %popcnt(i64) -> i64 {
block0(v0: i64):
    v1 = popcnt v0
    return v1
}

; VCode:
; block0:
;   popcntq %rdi, %rax
;   retq
