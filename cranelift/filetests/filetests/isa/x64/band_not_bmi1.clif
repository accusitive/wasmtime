test compile precise-output
set opt_level=speed
target x86_64 has_bmi1

function %f1(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v3 = bnot v1
    v2 = band v0, v3
    return v2
}

; VCode:
; block0:
;   andnl %edi, %esi, %eax
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   andnl %edi, %esi, %eax
;   retq

function %reversed_operands(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = bnot v0
    v3 = band v2, v1
    return v3
}

