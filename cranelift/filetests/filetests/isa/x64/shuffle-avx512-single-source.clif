function %shuffle_rhs_only(i8x16, i8x16) -> i8x16 {
block0(v0: i8x16, v1: i8x16):
    v2 = shuffle v0, v1, [16 20 17 21 18 22 19 23 24 28 25 29 26 30 27 31]
    return v2
}

