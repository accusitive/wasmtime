test compile precise-output
target x86_64

function %f0(i64 vmctx) -> i64, i64 {
  gv0 = vmctx
  stack_limit = gv0
  ss0 = explicit_slot 8
  ss1 = explicit_slot 32, align=16

block0(v0: i64):
  v1 = stack_addr.i64 ss0
  v2 = stack_addr.i64 ss1
  return v1, v2
}

