function %umul_flags_brif(i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v2: i32):
  v4, v5 = umul_overflow v0, v1
  brif v5, block1, block2

block1:
  v6 = iadd v4, v4
  return v6

block2:
  return v2
}

