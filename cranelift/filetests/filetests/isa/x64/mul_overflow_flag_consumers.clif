function %smul_flags_select_load_product_stored(i64, i32, i64, i64) -> i64 {
block0(v0: i64, v1: i32, v2: i64, v3: i64):
  v4 = load.i32 v0
  v5, v6 = smul_overflow v1, v4
  store v5, v0
  v7 = select v6, v2, v3
  return v7
}

