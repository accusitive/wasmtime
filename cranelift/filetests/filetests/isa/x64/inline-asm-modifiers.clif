;; %= expands to a per-instantiation number used in a local label name.
function %unique(i64) -> i64 {
block0(v0: i64):
    v1 = inline_asm "jmp %=f\n\tnop\n%=:\n\tnop" : "=r" : "r"(v0)
    return v1
}

