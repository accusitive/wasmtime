function %consts() -> i64 system_v {
block0:
  v0 = iconst.i64 42
  v1 = iconst.i64 -1234
  v2 = iadd v0, v1
  v3 = iconst.i64 0x123456789abcdef0
  v4 = iadd v2, v3
  return v4
}

