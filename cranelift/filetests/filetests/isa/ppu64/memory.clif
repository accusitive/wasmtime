test compile precise-output
target powerpc64-unknown-linux-gnu

function %store_load(i64, i64) -> i64 system_v {
block0(v0: i64, v1: i64):
  store notrap aligned v1, v0
  v4 = load.i64 notrap aligned v0
  return v4
}

