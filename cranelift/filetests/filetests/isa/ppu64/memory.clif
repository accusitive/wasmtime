; block0: ; offset 0x0
;   std r4, 0(r3)
;   ld r3, 0(r3)
;   blr

function %small_loads(i64) -> i64 system_v {
block0(v0: i64):
  v1 = uload8.i64 notrap aligned v0
  v2 = uload16.i64 notrap aligned v0
  v3 = uload32.i64 notrap aligned v0
  v4 = iadd v1, v2
  v5 = iadd v4, v3
  return v5
}

