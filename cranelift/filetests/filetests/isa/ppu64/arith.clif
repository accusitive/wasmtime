; block0:
;   add r3,r3,r4
;   addi r1,r1,+16
;   ld r31,0(%sp)
;   ld r0,8(%sp)
;   mtspr r0,8
;   addi r1,r1,+16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r31, 0(r1)
;   std r0, 8(r1)
;   mr r31, r1
;   addi r1, r1, -0x10
; block1: ; offset 0x18
;   add r3, r3, r4
;   addi r1, r1, 0x10
;   ld r31, 0(r1)
;   ld r0, 8(r1)
;   mtlr r0
;   addi r1, r1, 0x10
;   blr

