;   mr r31,r1
;   addi r1,r1,-16
; block0:
;   fadd f1,f1,f2
;   addi r1,r1,+16
;   ld r31,0(%sp)
;   ld r0,8(%sp)
;   mtspr r0,8
;   addi r1,r1,+16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   mflr r0
;   addi r1, r1, -0x10
;   std r31, 0(r1)
;   std r0, 8(r1)
;   mr r31, r1
;   addi r1, r1, -0x10
; block1: ; offset 0x18
;   fadd f1, f1, f2
;   addi r1, r1, 0x10
;   ld r31, 0(r1)
;   ld r0, 8(r1)
;   mtlr r0
;   addi r1, r1, 0x10
;   blr

function %fchain(f64, f64) -> f64 system_v {
block0(v0: f64, v1: f64):
  v2 = fmul v0, v1
  v3 = fsub v2, v0
  v4 = fdiv v3, v1
  return v4
}

