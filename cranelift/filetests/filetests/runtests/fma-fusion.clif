test run
set opt_level=speed
set enable_fma
target x86_64
target aarch64

;; With `enable_fma`, `fadd(fmul(x, y), z)` fuses into a single correctly
;; rounded `fma`. The example below is chosen so that the fused result
;; (0x1.000006p0, one rounding) differs from the double-rounded non-fused
;; sequence (0x1.000004p0): fma(1 + 2^-22, 1 + 2^-22, 2^-24).

function %fused_fma_f32(f32, f32, f32) -> f32 {
block0(v0: f32, v1: f32, v2: f32):
    v3 = fmul v0, v1
    v4 = fadd v3, v2
    return v4
}

; run: %fused_fma_f32(0x1.000002p0, 0x1.000002p0, 0x1.000000p-24) == 0x1.000006p0

function %fused_fma_f64(f64, f64, f64) -> f64 {
block0(v0: f64, v1: f64, v2: f64):
    v3 = fmul v0, v1
    v4 = fadd v3, v2
    return v4
}

; run: %fused_fma_f64(0x1.0000000000002p0, 0x1.0000000000002p0, 0x1.0000000000000p-53) == 0x1.0000000000005p0

;; x*y - z fuses to fma(x, y, -z).
function %fused_fsub_f32(f32, f32, f32) -> f32 {
block0(v0: f32, v1: f32, v2: f32):
    v3 = fmul v0, v1
    v4 = fsub v3, v2
    return v4
}

; run: %fused_fsub_f32(0x1.8p0, 0x1.0p1, 0x1.0p0) == 0x1.0p1