test alias-analysis
set opt_level=speed
target aarch64

;; Test that extension modes are properly accounted for when deciding
;; whether loads alias.

function %f0(i64 vmctx, i32) -> i32, i32, i32, i64, i64, i64 {
    gv0 = vmctx
    gv1 = load.i64 notrap readonly aligned gv0+8

block0(v0: i64, v1: i32):
    v2 = load.i64 notrap readonly aligned v0+8

    ;; Initial load. This will not be reused by anything below, even
    ;; though it does access the same address.
    v3 = load.i32 v2+8

    ;; A narrower extending load cannot reuse a wider plain load's value
    ;; (native endianness makes truncation unsound), so this must remain.
    v4 = uload8.i32 v2+8
    ; check: v4 = uload8.i32 v2+8

    ;; Same-width extending loads can be forwarded to each other: the
    ;; `sload8` reads the same byte as the `uload8` above and merely
    ;; sign-extends it, which is endianness-independent.
    v5 = sload8.i32 v2+8
    ; check: v10 = ireduce.i8 v4
    ; check: v11 = sextend.i32 v10
    ; check: v5 -> v11

    v6 = load.i64 v2+8
    ; check: v6 = load.i64 v2+8

    ;; 8-bit store only partially overwrites the address.
    istore8 v6, v2+8

    ;; This must not pick up the store data.
    v7 = load.i64 v2+8
    ; check: v7 = load.i64 v2+8

    ;; Another store, this one non-truncating but actually using an
    ;; `i8` value.
    v8 = iconst.i8 123
    store.i8 v8, v2+8

    v9 = load.i64 v2+8
    ; check: v9 = load.i64 v2+8

    return v3, v4, v5, v6, v7, v9
}
