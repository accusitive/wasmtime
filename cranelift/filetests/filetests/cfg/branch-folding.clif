test optimize
set opt_level=speed
target x86_64

;; Test the branch-folding pass, which fuses blocks containing nothing but an
;; unconditional `jump` into their unique predecessor, threading block
;; arguments.

function %fold_chain(i64) -> i64 fast {
block0(v0: i64):
    jump block1(v0)

block1(v1: i64):
    jump block2(v1)

block2(v2: i64):
    return v2
}

; check: function %fold_chain
; nextln: block0(v0: i64):
; nextln:     jump block2
; check: block2:
; nextln:     return v0

function %fold_join(i32, i32) -> i32 fast {
block0(v0: i32, v1: i32):
    brif v0, block1(v0), block2(v1)

block1(v2: i32):
    jump block3(v2)

block2(v3: i32):
    jump block3(v3)

block3(v4: i32):
    return v4
}

; check: function %fold_join
; nextln: block0(v0: i32, v1: i32):
; nextln:     brif v0, block3(v0), block3(v1)
; check: block3(v4: i32):
; nextln:     return v4

function %fold_latch(i32) -> i32 fast {
block0(v0: i32):
    jump block1(v0)

block1(v1: i32):
    brif v1, block2(v1), block3(v1)

block2(v2: i32):
    jump block1(v2)

block3(v3: i32):
    return v3
}

; check: function %fold_latch
; nextln: block0(v0: i32):
; nextln:     jump block1
; check: block1:
; nextln:     brif.i32 v0, block2, block3
; check: block2:
; nextln:     jump block1
; check: block3:
; nextln:     return v0